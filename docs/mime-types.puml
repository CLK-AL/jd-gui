' ========================================
' Core Registry & SPI Framework
' ========================================
package "Core SPI Framework" #E8F5E9 {
    interface LanguageSyntaxProvider <<SPI>> {
        +languageId: String
        +displayName: String
        +syntaxStyle: String
        +fileExtensions: Collection<String>
        +priority: Int
        --
        +tokenize(source: String): List<SyntaxToken>
        +extractDeclarations(source: String)
        +extractReferences(source: String)
        +supportsExtension(ext: String): Boolean
    }
    note top of LanguageSyntaxProvider
        **SPI Registration:**
        META-INF/services/org.jd.gui.spi.LanguageSyntaxProvider
        **40+ providers registered**
        **Pattern:** Strategy Pattern
    end note

    interface TreeNodeFactory <<SPI>> {
        +getSelectors(): String[]
        +getPathFactory(): PathFactory
        +make(api, entry): TreeNode
    }
    note right of TreeNodeFactory
        **SPI Registration:**
        META-INF/services/org.jd.gui.spi.TreeNodeFactory
        **35+ factories registered**
        **Pattern:** Factory Pattern
    end note

    interface ContainerFactory <<SPI>> {
        +getType(): String
        +accept(api, path): Boolean
        +make(api, container, entry): Container
    }
    note right of ContainerFactory
        **7 implementations:**
        - KarContainerFactoryProvider
        - JavaModuleContainerFactoryProvider
        - EarContainerFactoryProvider
        - WarContainerFactoryProvider
        - JarContainerFactoryProvider
        - GenericContainerFactoryProvider
    end note

    interface FileLoader <<SPI>> {
        +getExtensions(): String[]
        +load(api, file): FileLoader.Entry
    }
    note right of FileLoader
        **10 implementations:**
        - AarFileLoaderProvider
        - ClassFileLoaderProvider
        - EarFileLoaderProvider
        - JarFileLoaderProvider
        - JavaFileLoaderProvider
        - JavaModuleFileLoaderProvider
        - KarFileLoaderProvider
        - LogFileLoaderProvider
        - WarFileLoaderProvider
        - ZipFileLoaderProvider
    end note

    class LanguageSyntaxProviderRegistry <<Registry>> {
        -providers: Map<String, LanguageSyntaxProvider>
        +getProviderByLanguage(id): LanguageSyntaxProvider?
        +getProviderByExtension(ext): LanguageSyntaxProvider?
        +registerProvider(provider)
    }

    LanguageSyntaxProviderRegistry --> LanguageSyntaxProvider : manages
}

