@startuml MIME Types and File Extension Handlers

!theme plain
skinparam backgroundColor #FEFEFE
skinparam classFontSize 12
skinparam noteFontSize 10
skinparam packageStyle rectangle

title JD-GUI MIME Types and File Extension Handler Architecture

' ========================================
' Core Registry
' ========================================
package "Core Registry" #E8F5E9 {
    interface LanguageSyntaxProvider {
        +languageId: String
        +displayName: String
        +syntaxStyle: String
        +fileExtensions: Collection<String>
        +priority: Int
        +tokenize(source: String): List<SyntaxToken>
        +extractDeclarations(source: String): List<Declaration>
        +extractReferences(source: String): List<Reference>
        +supportsExtension(ext: String): Boolean
    }

    interface LanguageSyntaxProviderKt {
        +languageId: String
        +displayName: String
        +syntaxStyle: String
        +fileExtensions: Collection<String>
        +tokenMakerClassName: String
        +priority: Int
        +parse(input: CharStream, listener: ParseTreeListener)
        +createDeclarationListener(): LanguageDeclarationListenerKt?
        +createReferenceListener(): LanguageReferenceListenerKt?
    }

    class LanguageSyntaxProviderRegistry <<expect/actual>> {
        +getProviders(): List<LanguageSyntaxProvider>
        +getProviderByLanguage(id: String): LanguageSyntaxProvider?
        +getProviderByExtension(ext: String): LanguageSyntaxProvider?
        +registerProvider(provider: LanguageSyntaxProvider)
    }
}

