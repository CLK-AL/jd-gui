' Kotlin Server Implementation
' ========================================
package "Kotlin Server (Reusing Pattern)" #E8EAF6 {
    interface "TreeNodeFactory (Kotlin)" as KotlinTreeNodeFactory <<interface>> {
        +factoryId: String
        +displayName: String
        +getSelectors(): Array<String>
        +getPathPattern(): Pattern?
        +priority: Int
        +make(entry, content): TreeNodeResult
    }
    note right of KotlinTreeNodeFactory
        **Location:**
        server/src/main/kotlin/
        al/clk/gui/server/treenode/

        **Same selector pattern:**
        {containerType}:{fileOrDir}:{pathPattern}
    end note

    class TreeNodeFactoryRegistry {
        +register(factory)
        +get(entry): TreeNodeFactory?
        -matchSelector(selector, path)
    }
    note right of TreeNodeFactoryRegistry
        Same matching algorithm
        as Java TreeNodeFactoryService
    end note

    class HandlerAdapterFactory {
        +adapts FileExtensionHandler
        +auto-generates selectors
    }
    note right of HandlerAdapterFactory
        Bridges existing handlers
        to TreeNodeFactory pattern
    end note

    KotlinTreeNodeFactory <|.. HandlerAdapterFactory
    TreeNodeFactoryRegistry o-- KotlinTreeNodeFactory
}

