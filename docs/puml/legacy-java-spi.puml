' ========================================
' Core API Interfaces
' ========================================
package "API Interfaces (api module)" #E3F2FD {
    interface API <<core>> {
        +openURI(uri: URI)
        +addPanel(title, icon, description, page)
        +getContextualActions(entry, fragment)
        +getPreferences(): Map<String, String>
    }
    note right of API
        **Package:** al.clk.gui.api.API
        Central interface for all services
        Implemented by MainController
    end note

    interface Container <<model>> {
        +getType(): String
        +getRoot(): Entry
        +getScheme(): String
    }
    note right of Container
        **Model for archives:**
        JAR, WAR, EAR, ZIP, directory
        --
        Nested Entry interface for
        file/directory navigation
    end note

    interface "Container.Entry" as Entry <<model>> {
        +getContainer(): Container
        +getParent(): Entry
        +getChildren(): Collection<Entry>
        +getPath(): String
        +getUri(): URI
        +getInputStream(): InputStream
    }

    interface Type <<model>> {
        +getFlags(): int
        +getName(): String
        +getSuperName(): String
        +getInterfaceNames(): String[]
        +getFields(): Collection<Field>
        +getMethods(): Collection<Method>
    }
    note right of Type
        **Represents decompiled types**
        Fields, methods, inheritance
        --
        Nested interfaces:
        - Type.Field
        - Type.Method
    end note

    interface Indexes <<model>> {
        +getIndex(name): Map
        +SIZE: int
    }
    note right of Indexes
        **Search indexes:**
        - Strings
        - Type declarations
        - Method/field refs
        - Inheritance
    end note

    Container *-- Entry : contains
    MainController ..|> API : implements
}

