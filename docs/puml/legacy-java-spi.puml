        -indexers: Collection<Indexer>
    }

    class SourceSaverService <<singleton>> {
        +{static} getInstance()
        +get(api, entry): SourceSaver
        -savers: Collection<SourceSaver>
    }

    class SourceLoaderService <<singleton>> {
        +{static} getInstance()
        +getLoaders(): Collection<SourceLoader>
    }

