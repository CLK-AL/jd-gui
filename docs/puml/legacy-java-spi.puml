' Service Registries
' ========================================
package "Service Registries (app/service)" #E1BEE7 {
    class ExtensionService <<singleton>> {
        +{static} getInstance(): ExtensionService
        +<T> load(type: Class<T>): Collection<T>
        -loadFromClasspath()
        -loadFromExtDir()
    }
    note right of ExtensionService
        **Core ServiceLoader wrapper**
        Uses Java SPI pattern
        --
        Loads from:
        1. Classpath (META-INF/services)
        2. ext/ directory (plugins)
    end note

    class ContainerFactoryService <<singleton>> {
        +{static} getInstance()
        +get(api, path): ContainerFactory
        -factories: Collection<ContainerFactory>
    }

    class FileLoaderService <<singleton>> {
        +{static} getInstance()
        +get(api, file): FileLoader
        -loaders: Collection<FileLoader>
    }

    class TreeNodeFactoryService <<singleton>> {
        +{static} getInstance()
        +get(api, entry): TreeNodeFactory
        -factoriesBySelector: Map
    }

    class PanelFactoryService <<singleton>> {
        +{static} getInstance()
        +get(container): PanelFactory
        -factories: Collection<PanelFactory>
    }

    class TypeFactoryService <<singleton>> {
        +{static} getInstance()
        +get(api, entry, fragment): TypeFactory
        -factories: Collection<TypeFactory>
    }

    class IndexerService <<singleton>> {
        +{static} getInstance()
